+class BambuStudio(PrusaSlicer):
+    def check_identity(self, data: str) -> Optional[Dict[str, str]]:
+        match = re.search(
+            r";\s*(?:generated by\s+)?BambuStudio\s+([^\s]+)", data)
+        if match:
+            return {'slicer': 'BambuStudio', 'slicer_version': match.group(1)}
+        return None
+
+    def set_data(self, header_data: str, footer_data: str, fsize: int) -> None:
+        # Bambu Studio writes its configuration block in the header.
+        super().set_data(header_data, header_data + '\n' + footer_data, fsize)
+
+    def parse_layer_count(self) -> Optional[int]:
+        return _regex_find_int(
+            r";\s*total layer number:\s*(\d+)", self.header_data)
+
+    def parse_first_layer_height(self) -> Optional[float]:
+        height = _regex_find_first(
+            r";\s*initial_layer_print_height\s*=\s*(\d+\.?\d*)",
+            self.header_data)
+        if height is not None:
+            return height
+        return super().parse_first_layer_height()
+
+    def parse_object_height(self) -> Optional[float]:
+        height = _regex_find_first(
+            r";\s*max_z_height:\s*(\d+\.?\d*)", self.header_data)
+        if height is not None:
+            return height
+        return self._parse_max_float(
+            r";\s*Z_HEIGHT:\s*(\d+\.?\d*)", self.footer_data)
 
