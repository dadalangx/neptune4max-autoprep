+void
+adxl345_tap_shutdown(void)
+{
+    uint8_t oid;
+    struct adxl345 *ax;
+    foreach_oid(oid, ax, command_config_adxl345) {
+        sched_del_timer(&ax->tap_timer);
+        ax->tap_flags = 0;
+        ax->tap_ts = NULL;
+    }
+}
