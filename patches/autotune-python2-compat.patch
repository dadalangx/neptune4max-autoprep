+if not hasattr(tmc, "TMCtstepHelper"):
+    def _compat_tmc_tstep_helper(step_dist, mres, tmc_freq, velocity):
+        if velocity > 0.0:
+            step_dist_256 = step_dist / (1 << mres)
+            threshold = int(tmc_freq * step_dist_256 / velocity + 0.5)
+            return max(0, min(0xfffff, threshold))
+        return 0xfffff
+
+    tmc.TMCtstepHelper = _compat_tmc_tstep_helper
